datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  companyName    String
  isWholesale    Boolean  @default(true)
  createdAt      DateTime @default(now())
}
