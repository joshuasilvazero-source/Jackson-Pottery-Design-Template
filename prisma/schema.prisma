datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  companyName    String
  isWholesale    Boolean  @default(true)
  createdAt      DateTime @default(now())
}
